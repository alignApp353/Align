.next{flex:1;border:none;background:var(--brand-dark);color:#fff}
.next:disabled{opacity:.55}
.note{margin-top:12px;color:var(--muted);font-size:10px;line-height:1.5;text-align:center}
@media(max-width:560px){
  .card{padding:20px}
  .actions{position:sticky;bottom:10px;padding:10px;background:var(--sticky-bg);border-radius:18px}
  .back{width:95px}
  h1{font-size:27px}
}
</style>
