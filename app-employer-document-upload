<main class="shell"><header class="top"><div class="brand">Alygnn<span>.</span></div><div class="secure">Secure PDF upload</div></header><div class="progress-copy"><span>Building your Hiring Profile</span><span>43%</span></div><div class="progress"><div></div></div><section class="card"><div class="eyebrow">Company verification</div><h1>Verify your business.</h1><p class="intro">Upload one official document showing your legal business name and EIN. You can continue building your profile and creating jobs while Alygnn reviews it.</p><div class="accepted"><h2>Accepted documents</h2><ul><li>IRS CP 575 EIN Confirmation Letter</li><li>IRS Letter 147C</li><li>Official IRS EIN Assignment Letter</li></ul></div><input id="document" type="file" accept="application/pdf,.pdf"><div class="drop" id="drop-zone" tabindex="0" role="button" aria-label="Choose a PDF verification document"><div><div class="file-icon" id="file-icon">PDF</div><h3 id="file-title">Drop your PDF here</h3><p id="file-copy">or choose a file from your device<br>PDF only • Maximum 10 MB</p><button class="choose" id="choose-button" type="button">Choose PDF</button></div></div><div class="why"><h2>Why does Alygnn verify businesses?</h2><p>Every employer is reviewed before its jobs become visible to candidates. This helps protect job seekers from fraudulent postings and builds trust across Alygnn.</p></div><div id="message" class="message" aria-live="polite"></div><div class="actions"><button class="btn back" id="back-button" type="button">Back</button><button class="btn next" id="submit-button" type="button" disabled>Submit Document</button></div><p class="note">Your document is stored privately and is available only to authorized Alygnn reviewers.</p></section></main>
<script>
const SUPABASE_URL='https://auth.alygnn.com';const SUPABASE_KEY='sb_publishable_3l8krRh6WCyvKfNumWDBDw_C6CKr7rG';const BUCKET='employer-verification-documents';const sb=supabase.createClient(SUPABASE_URL,SUPABASE_KEY,{auth:{persistSession:true,autoRefreshToken:true}});const input=document.getElementById('document');const dropZone=document.getElementById('drop-zone');const chooseButton=document.getElementById('choose-button');const submitButton=document.getElementById('submit-button');const message=document.getElementById('message');let selectedFile=null;let session=null;let companyId=localStorage.getItem('alygnn_company_id')||'';function showMessage(text,type='error'){message.textContent=text;message.className='message '+type}function clearMessage(){message.textContent='';message.className='message'}function validateFile(file){if(!file)return false;const isPdf=file.type==='application/pdf'||file.name.toLowerCase().endsWith('.pdf');if(!isPdf){showMessage('Choose a PDF file. Other file types are not accepted.');return false}if(file.size>10*1024*1024){showMessage('Your PDF must be 10 MB or smaller.');return false}return true}function selectFile(file){clearMessage();if(!validateFile(file))return;selectedFile=file;dropZone.classList.add('has-file');document.getElementById('file-icon').textContent='✓';document.getElementById('file-title').textContent=file.name;document.getElementById('file-copy').textContent=(file.size/1024/1024).toFixed(2)+' MB • Ready to submit';chooseButton.textContent='Choose Different PDF';submitButton.disabled=false}chooseButton.addEventListener('click',e=>{e.stopPropagation();input.click()});dropZone.addEventListener('click',()=>input.click());dropZone.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();input.click()}});input.addEventListener('change',()=>selectFile(input.files[0]));['dragenter','dragover'].forEach(name=>dropZone.addEventListener(name,e=>{e.preventDefault();dropZone.classList.add('dragging')}));['dragleave','drop'].forEach(name=>dropZone.addEventListener(name,e=>{e.preventDefault();dropZone.classList.remove('dragging')}));dropZone.addEventListener('drop',e=>selectFile(e.dataTransfer.files[0]));document.getElementById('back-button').onclick=()=>location.replace('app-employer-onboarding.html');submitButton.onclick=async()=>{if(!selectedFile||!validateFile(selectedFile))return;submitButton.disabled=true;submitButton.textContent='Uploading…';clearMessage();try{if(!session)throw new Error('Your session expired. Sign in again.');if(!companyId)throw new Error('Your company could not be identified. Return to onboarding and try again.');const safeName=selectedFile.name.replace(/[^a-zA-Z0-9._-]/g,'-').slice(-100);const storagePath=`${companyId}/${session.user.id}/${Date.now()}-${safeName}`;const {error:uploadError}=await sb.storage.from(BUCKET).upload(storagePath,selectedFile,{cacheControl:'3600',upsert:false,contentType:'application/pdf'});if(uploadError)throw uploadError;const {error:recordError}=await sb.from('employer_verification_documents').insert({company_id:companyId,uploaded_by:session.user.id,document_type:'ein_verification',storage_path:storagePath,original_file_name:selectedFile.name,mime_type:'application/pdf',file_size_bytes:selectedFile.size,review_status:'pending_review'});if(recordError){await sb.storage.from(BUCKET).remove([storagePath]);throw recordError}localStorage.setItem('alygnn_verification_document_submitted','true');localStorage.setItem('alygnn_employer_verification_status','pending_review');showMessage('Your document was submitted successfully.','success');setTimeout(()=>location.replace('app-employer-verification-status.html'),700)}catch(error){console.error(error);showMessage(error.message||'Unable to upload your document.');submitButton.disabled=false;submitButton.textContent='Submit Document'}};(async()=>{const result=await sb.auth.getSession();session=result.data.session;if(!session){location.replace('app-employer-login.html');return}if(!companyId){const {data:membership}=await sb.from('company_members').select('company_id,companies(verification_status)').eq('user_id',session.user.id).eq('membership_status','active').limit(1).maybeSingle();if(membership?.company_id){companyId=membership.company_id;localStorage.setItem('alygnn_company_id',companyId);const company=Array.isArray(membership.companies)?membership.companies[0]:membership.companies;if(company?.verification_status==='approved')location.replace('app-employer-dashboard.html')}}})();
</script></body></html>
