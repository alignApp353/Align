*{box-sizing:border-box;margin:0;padding:0;font-family:'DM Sans',Arial,sans-serif!important}:root{--brand:#5D7FA3;--brand-dark:#345F91;--sage:#8CB69B;--bg:#F6F8F7;--card:#FCFCFA;--text:#172333;--muted:#5D6C7C;--border:#DDE3E8;--danger:#B64040;--danger-bg:#FCEDED;--success:#18794E;--success-bg:#E8F6EE}body{min-height:100vh;background:radial-gradient(circle at 10% 5%,rgba(140,182,155,.16),transparent 28%),radial-gradient(circle at 90% 90%,rgba(93,127,163,.15),transparent 30%),var(--bg);color:var(--text)}button,input{font:inherit}.shell{width:100%;max-width:680px;min-height:100vh;margin:auto;padding:calc(20px + env(safe-area-inset-top)) 20px calc(32px + env(safe-area-inset-bottom))}.top{display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{font-family:'DM Serif Display',Georgia,serif!important;font-size:30px;color:var(--brand)}.brand span{color:var(--sage)}.secure{font-size:11px;font-weight:900;color:var(--success);background:var(--success-bg);padding:8px 11px;border-radius:999px}.progress-copy{margin-top:31px;display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:11px;font-weight:900;letter-spacing:.45px;text-transform:uppercase}.progress{height:9px;margin-top:9px;border-radius:999px;background:#E5EAEF;overflow:hidden}.progress>div{height:100%;width:43%;border-radius:inherit;background:linear-gradient(90deg,var(--brand-dark),var(--sage))}.card{margin-top:21px;padding:25px;border:1px solid var(--border);border-radius:26px;background:rgba(252,252,250,.96);box-shadow:0 18px 55px rgba(23,35,51,.08)}.eyebrow{color:var(--brand-dark);font-size:11px;font-weight:900;letter-spacing:.9px;text-transform:uppercase}h1{margin-top:9px;font-size:30px;line-height:1.1;letter-spacing:-.7px;font-weight:900}.intro{margin-top:12px;color:var(--muted);font-size:14px;line-height:1.65}.accepted{margin-top:20px;padding:16px;border:1px solid var(--border);border-radius:18px;background:#fff}.accepted h2{font-size:13px}.accepted ul{list-style:none;display:grid;gap:9px;margin-top:12px}.accepted li{font-size:12px;font-weight:800}.accepted li:before{content:'✓';margin-right:9px;color:var(--success)}.drop{margin-top:18px;min-height:210px;border:2px dashed #BCC8D3;border-radius:22px;background:#fff;display:grid;place-items:center;padding:24px;text-align:center;cursor:pointer;transition:.2s ease}.drop:hover,.drop.dragging{border-color:var(--brand-dark);background:#F4F8FB}.drop.has-file{border-style:solid;border-color:var(--success);background:var(--success-bg)}.file-icon{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;margin:auto;background:#EDF3F8;color:var(--brand-dark);font-size:24px;font-weight:900}.drop h3{margin-top:14px;font-size:16px}.drop p{margin-top:7px;color:var(--muted);font-size:12px;line-height:1.5}.choose{display:inline-grid;place-items:center;min-height:42px;margin-top:14px;padding:0 18px;border:0;border-radius:13px;background:var(--brand-dark);color:#fff;font-size:12px;font-weight:900}#document{position:absolute;left:-9999px}.why{margin-top:18px;padding:16px;border-radius:18px;background:#EDF3F8}.why h2{font-size:14px}.why p{margin-top:7px;color:var(--muted);font-size:12px;line-height:1.55}.message{display:none;margin-top:16px;padding:13px 14px;border-radius:14px;font-size:12px;font-weight:800;line-height:1.5}.message.error{display:block;background:var(--danger-bg);color:var(--danger)}.message.success{display:block;background:var(--success-bg);color:var(--success)}.actions{display:flex;gap:10px;margin-top:25px}.btn{min-height:53px;border-radius:16px;font-size:13px;font-weight:900}.back{width:120px;border:1px solid var(--border);background:#fff;color:var(--text)}.next{flex:1;border:none;background:var(--brand-dark);color:#fff}.next:disabled{opacity:.55}.note{margin-top:12px;color:var(--muted);font-size:10px;line-height:1.5;text-align:center}@media(max-width:560px){.card{padding:20px}.actions{position:sticky;bottom:10px;padding:10px;background:rgba(246,248,247,.94);border-radius:18px}.back{width:95px}h1{font-size:27px}}
