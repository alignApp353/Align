#document{position:absolute;left:-9999px}
.why{margin-top:18px;padding:16px;border-radius:18px;background:var(--surface-soft)}
.why h2{font-size:14px}
.why p{margin-top:7px;color:var(--muted);font-size:12px;line-height:1.55}
.message{display:none;margin-top:16px;padding:13px 14px;border-radius:14px;font-size:12px;font-weight:800;line-height:1.5}
.message.error{display:block;background:var(--danger-bg);color:var(--danger)}
.message.success{display:block;background:var(--success-bg);color:var(--success)}
